    "expected_escalation": "URGENT_24H",
    "expected_action": "Assessment within 24 hours for pancreatitis risk. The calculated LDL is unusable; do not report it.",
    "rationale": "A triglyceride above 1000 carries acute pancreatitis risk and needs prompt attention. The Friedewald LDL beside it is arithmetically meaningless and would understate risk if read as real.",
    "traps": [
      "narrating a calculated LDL as if it were measured",
      "under-calling severe hypertriglyceridemia because the LDL 'looks fine'"
    ],
    "must_not_claim": [
      "the LDL is X",
      "LDL is at goal",
      "cholesterol is well controlled"
